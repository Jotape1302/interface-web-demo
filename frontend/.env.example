# Variáveis públicas: nunca inclua credenciais neste arquivo.
# demo usa dados fictícios; live consulta a API e nunca recorre ao mock.
NEXT_PUBLIC_DATA_MODE=demo
# URL pública autorizada da API. Vazio usa a mesma origem do frontend.
NEXT_PUBLIC_API_BASE_URL=
# Opcional: usuário do bot da Contagem de Estoque no Telegram (sem @), para o botão
# "Abrir no Telegram" na página da automação. Vazio = o botão não aparece.
NEXT_PUBLIC_STOCK_BOT_USERNAME=
