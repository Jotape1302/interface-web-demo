# Copie para coletor.env (fica fora do git) e ajuste. chmod 600 coletor.env.
# Mesmo valor de INCIDENTES_TOKEN do orquestrador no PC e de AGENTES_QWEN_TOKEN do gateway (mínimo 32 caracteres):
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INCIDENTES_TOKEN=
# Ponta do túnel SSH reverso na VPS (o PC abre -R 127.0.0.1:8790:127.0.0.1:8790).
INCIDENTES_URL=http://127.0.0.1:8790/incidentes
# Pasta do docker-compose.yml (padrão: a raiz do repositório).
# COMPOSE_DIR=/home/usuario/norvia/interface-web
# SERVICOS=gateway automacao-nfe automacoes-marketplace automacoes-marketing contagem-estoque
# (serviço que não existir no compose é ignorado com aviso no log)
# DOCKER_HOST=unix:///run/user/1000/docker.sock
# Repasse do estado dos agentes para a aba "Agentes Qwen" do painel (vazio desliga):
# GATEWAY_ESTADO_URL=http://127.0.0.1:3100/api/agentes-qwen/estado
# Ponte do classificador Qwen da revisão de NF-e pelo gateway, com o mesmo token (vazio desliga):
# GATEWAY_FINANCEIRO_URL=http://127.0.0.1:3100/api/agentes-qwen/financeiro
