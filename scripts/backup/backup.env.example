# ==============================================================================
# backup.env.example - Configuração do backup (scripts/backup/backup.sh)
# ==============================================================================
# Copie para backup.env nesta pasta:  cp backup.env.example backup.env && chmod 600 backup.env
# O backup.env está no .gitignore — nunca commite a senha do banco.
# ==============================================================================

# Onde os backups ficam. Use um disco/partição diferente do banco, se houver.
BACKUP_DIR=/home/jotape1302/backups/norvia

# Quantos dias de backups diários manter.
BACKUP_RETENTION_DAYS=14

# MariaDB. Com MARIADB_CONTAINER preenchido, o dump roda dentro do container
# (docker exec) e DB_HOST/DB_PORT são ignorados. Nome do container: `docker ps`.
MARIADB_CONTAINER=
DB_HOST=127.0.0.1
DB_PORT=3306
# Usuário SÓ de leitura (SELECT, SHOW VIEW, TRIGGER, EVENT, LOCK TABLES) nos bancos abaixo —
# não use o root nem o usuário da aplicação. SQL pronto no README ("Usuário do banco só para backup").
# A senha não aparece na linha de comando (vai pelo ambiente para o docker exec / mariadb-dump).
DB_USER=
DB_PASSWORD=
# Bancos, separados por espaço.
BACKUP_DB_NAMES="financeiro"

# Pastas copiadas no caches.tar.gz, separadas por espaço (caminhos absolutos no
# servidor). As da automacao-nfe guardam o estado da revisão de NF-e e o cache do
# Dashboard Financeiro. Os certificados A1 (secrets/) ficam de fora de propósito.
BACKUP_CACHE_PATHS="/home/jotape1302/norvia/interface-web/backend/automations/automacoes-financeiro/data /home/jotape1302/norvia/interface-web/backend/automations/automacoes-financeiro/pending_review /home/jotape1302/norvia/interface-web/backend/automations/automacoes-financeiro/archived /home/jotape1302/norvia/interface-web/backend/automations/automacoes-financeiro/failed /home/jotape1302/norvia/interface-web/backend/automations/automacoes-financeiro/processed"

# Padrões que ficam fora do caches.tar.gz (tar --exclude). O padrão já tira
# certificados e chaves (certs/, secrets/, *.key, *.pem, *.pfx, *.p12, *.crt).
# BACKUP_CACHE_EXCLUDES="certs secrets *.key *.pem *.pfx *.p12 *.crt"

# Opcional: cópia fora do servidor (rsync), ex.: usuario@nas.local:/backups/norvia
# Precisa de chave SSH sem senha para o usuário que roda o timer.
BACKUP_RSYNC_TARGET=

# Opcional, recomendado com BACKUP_RSYNC_TARGET: criptografia com age por chave PÚBLICA.
# Com ela, o dump e os caches ganham uma cópia .age e só os .age (+ SHA256SUMS) vão para a
# cópia externa. A chave PRIVADA fica fora do servidor (ver README, "Criptografia").
# Uma ou mais chaves age1… separadas por espaço ou vírgula. Exige o pacote `age` no servidor:
# se a variável estiver definida e o age não existir, o backup falha (aparece na Saúde do sistema).
BACKUP_AGE_RECIPIENT=
# Alternativa: arquivo com uma chave por linha (age1… ou ssh-ed25519 …).
# BACKUP_AGE_RECIPIENTS_FILE=/home/jotape1302/.config/norvia-backup/recipients.txt
# AGE_BIN=age
