# ==============================================================================
# .env.example - API Gateway Central Norvia Automações
# ==============================================================================
PORT=3100
DATA_MODE=demo
# Só estas origens (sem curingas de IP privado/ddns). Em produção:
CORS_ORIGINS=https://servidor.norvia.example
# Chave enviada às automações (X-Internal-Key). Mesmo valor no .env das automações; mín. 32 caracteres.
AUTOMATIONS_INTERNAL_KEY=
# Proxies cujos X-Forwarded-For/X-Real-IP valem (IP/CIDR, vírgula). Padrão: loopback + faixas privadas.
TRUSTED_PROXIES=

# Banco de dados MariaDB
DB_HOST=mariadb
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha
DB_NAME=financeiro

# Motores Python Internos
DANFE_API_URL=http://automacao-nfe:8000
MARKETPLACE_API_URL=http://automacoes-marketplace:8001

# Integração n8n
N8N_BASE_URL=https://n8n.seuservidor.com
N8N_API_KEY=sua_chave_n8n
N8N_WORKFLOW_IDS=id1,id2,id3,id4

# Contagem de Estoque (Volume montado com contagens.json e imagens/)
CONTAGEM_REGISTRO_DIR=./data/contagem_estoque/registro
# API interna da contagem (lançamento no estoque do Tiny ao conferir). Padrão: http://contagem-estoque:8002
CONTAGEM_API_URL=
