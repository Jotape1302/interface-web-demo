# Copie para .env (ou passe como environment no docker-compose). Nunca commite o .env.

# Chave que o gateway manda em TODA chamada (header X-Internal-Key). A MESMA do gateway e da
# automacoes-financeiro. Mínimo 32 caracteres (openssl rand -hex 32). Sem ela, tudo menos /health
# responde 503. INTERNAL_AUTH_DISABLED=true desliga a chave (só dev/testes).
AUTOMATIONS_INTERNAL_KEY=
INTERNAL_AUTH_DISABLED=false

# Access token de cada conta do Mercado Livre (NORVIA = Norvia Campinas). A renovação dos
# tokens NÃO é feita por esta automação: um fluxo externo (a definir) renova e grava o token em
# data/ml_tokens.json, que tem prioridade sobre estas variáveis (úteis só para teste: expiram em 6 h).
ML_REVESTA_ACCESS_TOKEN=
ML_NORVIA_ACCESS_TOKEN=

# Integração TMS (script scripts/sync_ml_tokens.py para atualizar data/ml_tokens.json)
# TMS_BASE_URL=https://servidor.norvia.example/tms_api
# TMS_USER=seu_usuario_tms
# TMS_PASSWORD=sua_senha_tms

# MariaDB (mesmo servidor da automacoes-financeiro). A tabela dimensoes_produtos (criada sozinha)
# fica no banco próprio do Marketplace (DB_NAME); os tokens do Tiny são lidos de
# <TINY_TOKENS_DB>.api_tokens (banco do financeiro, renovados fora daqui). O usuário precisa de
# acesso total ao DB_NAME e SELECT em TINY_TOKENS_DB.api_tokens. Sem isso fica só em memória.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=marketplace
TINY_TOKENS_DB=financeiro

# Contas do Tiny usadas nos anúncios (conta_identificador em api_tokens).
TINY_CONTAS=norvia_campinas,revesta

# Padronização de dimensões: hora da coleta diária e embalagem padrão (seção 5 x 7 cm,
# comprimento escolhido pelo tamanho do produto).
DIMENSOES_HORA_COLETA=6
EMBALAGEM_SECAO_CM=5,7
EMBALAGEM_COMPRIMENTOS_CM=100,200,300

# Contas com Mercado Envios 1 ativo (separadas por vírgula).
ML_CONTAS_COM_ME1=norvia

# Hora local da verificação diária e espera antes de conferir cada alteração.
FRETES_HORA_DIARIA=7
FRETES_MINUTOS_CONFERENCIA=10

# Limites de tamanho da EMBALAGEM para ME2 (anúncio com a tag me2_available vai para ME2 de qualquer jeito).
ME2_MAX_LADO_CM=100
ME2_MAX_SOMA_CM=200

DATA_DIR=./data
API_PORT=8001
