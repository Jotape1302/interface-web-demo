# ==============================================================================
# .env.example - Automação Fiscal: Varredura SEFAZ -> Revisão Humana -> Tiny ERP
# ==============================================================================
# Copie este arquivo para .env na raiz de 'automacoes-financeiro':
#   cp .env.example .env
# Em seguida, preencha os valores de acordo com as suas integrações.
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. SEGURANÇA DA API (chave interna do gateway, modo mock, limites de upload)
# ------------------------------------------------------------------------------
# Chave que o gateway manda em TODA chamada (header X-Internal-Key). A MESMA no .env do gateway.
# Mínimo 32 caracteres. Gere com:  openssl rand -hex 32
# Sem ela, todas as rotas (menos /health e /api/v1/health) respondem 503.
AUTOMATIONS_INTERNAL_KEY=
# true desliga a chave (SÓ dev local/testes). Nunca em produção.
INTERNAL_AUTH_DISABLED=false
# true só em dev local: sem token do Tiny, simula o lançamento. Em produção deixe false
# (sem token a nota NÃO é dada como lançada e fica em revisão pendente).
MOCK_MODE=true
# Origens do navegador liberadas no CORS (vírgula). Vazio = nenhuma: o navegador fala só com o
# gateway, nunca direto com esta API.
CORS_ORIGINS=
# Upload manual de DANFE/XML: tamanho por arquivo, páginas por PDF e arquivos por lote.
UPLOAD_MAX_FILE_MB=20
UPLOAD_MAX_PDF_PAGES=50
UPLOAD_MAX_FILES=50

# ------------------------------------------------------------------------------
# 1. VARREDURA DIRETA NA SEFAZ (substitui a antiga esteira via pasta do Google Drive)
# ------------------------------------------------------------------------------
# Hora do dia (0-23, horário do servidor) em que a varredura diária automática roda.
# Também pode ser disparada a qualquer momento pelo botão "Rodar agora" na interface.
SEFAZ_SCAN_HOUR=6

# ------------------------------------------------------------------------------
# 2. TINY ERP (Lançamento Automático em Contas a Pagar)
# ------------------------------------------------------------------------------
# O Tiny suporta duas formas de autenticação:
#
# OPÇÃO A: OAuth 2.0 (Recomendado pela Tiny - renovação automática a cada 4 horas)
# Obtenha o Client ID e Client Secret em: Configurações > Extensões do Tiny > Aplicativos / API
TINY_CLIENT_ID=seu_tiny_client_id_aqui
TINY_CLIENT_SECRET=seu_tiny_client_secret_aqui
TINY_REFRESH_TOKEN=seu_refresh_token_inicial_aqui
TINY_REDIRECT_URI=https://localhost
TINY_TOKEN_CACHE_FILE=./data/tiny_token_cache.json

# OPÇÃO B: Token Estático Legado da API V2 (Alternativa mais simples)
# Obtenha em: Ferramentas > API no painel do Tiny
# TINY_API_TOKEN=seu_token_estatico_api2_aqui

# OPÇÃO C (Recomendada no Monorepo Multi-Tenant): MariaDB Centralizado
# Consulta dinamicamente a tabela 'api_tokens' sincronizada pelo n8n
DB_HOST=mariadb
DB_PORT=3306
DB_USER=norvia_user
DB_PASSWORD=norvia_pass
DB_NAME=financeiro

# Mapeamento opcional CNPJ ↔ Empresa (padrão já inclui todas as 4 filiais)
# CNPJ_COMPANY_MAP=43820617000166:fabrilux,36592814000100:revesta,27184930000107:norvia_campinas,27184930000280:norvia_curitiba

# Mapeamento opcional de Conta Financeira de Origem no Tiny ERP v3 para baixas (sobrescreve busca automática do Inter)
# TINY_CONTA_ORIGEM_MAP=norvia_curitiba:Inter Norvia Curitiba,norvia_campinas:Banco Inter,revesta:Banco Inter,fabrilux:Banco Inter


# Configuração das Contas a Pagar no Tiny

TINY_DEFAULT_CATEGORY=Despesas com Fornecedores
TINY_OCORRENCIA=U
TINY_HISTORICO_TEMPLATE=NF-e {numero_nota} - {emitente_nome} (Chave: {chave})

# ------------------------------------------------------------------------------
# 3. PROVEDOR DE CONSULTA DE NF-e (A partir da chave de 44 dígitos)
# ------------------------------------------------------------------------------
# Escolha um entre: sefaz_a1, receita_oficial, nuvem_fiscal, plugnotas, mock
# (Use 'mock' para testes locais sem certificado/consumo de cotas de consulta)
NFE_PROVIDER=sefaz_a1

# --- 3.1. Se usar NFE_PROVIDER=receita_oficial (API Serpro / Gateway gov.br) ---
# Obtenha em: https://apiserpro.serpro.gov.br/
RECEITA_CONSUMER_KEY=seu_consumer_key_serpro
RECEITA_CONSUMER_SECRET=seu_consumer_secret_serpro
# Ou token direto se já possuir:
# RECEITA_API_TOKEN=seu_bearer_token_serpro

# --- 3.2. Se usar NFE_PROVIDER=sefaz_a1 (Consulta Direta na SEFAZ com Certificado Digital A1) ---
# O sistema suporta UM ou MÚLTIPLOS certificados (vários CNPJs/filiais):
#
# CENÁRIO MULTI-CNPJ COM SENHAS DISTINTAS:
# Coloque todos os arquivos .pfx/.p12 na pasta ./secrets/
SEFAZ_CERTS_DIR=./secrets

# Como configurar senhas diferentes para cada certificado (escolha a forma mais fácil para você):
#
# OPÇÃO 1 (Recomendada): Variáveis individuais com o nome do arquivo ou CNPJ no .env:
# SEFAZ_PASSWORD_MATRIZ=senha_da_matriz
# SEFAZ_PASSWORD_FILIAL_PR=senha_do_parana
# (ou pelo CNPJ: SEFAZ_PASSWORD_12345678000195=senhaA)
#
# OPÇÃO 2: Arquivo .pass ao lado do certificado na pasta secrets/
# (Exemplo: se você tem secrets/matriz.pfx, basta criar secrets/matriz.pass com a senha dentro)
#
# OPÇÃO 3: Lista de pares arquivo:senha ou lista simples de senhas no .env:
# SEFAZ_PASSWORDS=matriz.pfx:senhaA, filial_pr.pfx:senhaB
# (ou apenas listando as senhas para auto-descoberta: SEFAZ_PASSWORDS=senhaA, senhaB, senhaC)
#
# OPÇÃO 4: Senha padrão única caso algum certificado use a mesma senha:
# SEFAZ_CERT_PASSWORD=senha_fallback
#
# CENÁRIO CNPJ ÚNICO (Alternativa se usar apenas um certificado):
# SEFAZ_CERT_PATH=./secrets/certificado_empresa.pfx
# SEFAZ_CNPJ=12345678000199
#
SEFAZ_UF=SP
SEFAZ_AMBIENTE=1  # 1=Produção, 2=Homologação

# --- 3.3. Se usar NFE_PROVIDER=nuvem_fiscal (Gateway Nuvem Fiscal) ---
# Obtenha em: https://dev.nuvemfiscal.com.br/
# NUVEM_FISCAL_CLIENT_ID=seu_client_id_nuvem_fiscal
# NUVEM_FISCAL_CLIENT_SECRET=seu_client_secret_nuvem_fiscal

# --- 3.4. Se usar NFE_PROVIDER=plugnotas (TecnoSpeed) ---
# Obtenha em: https://plugnotas.com.br/
# PLUGNOTAS_API_KEY=sua_api_key_plugnotas

# ------------------------------------------------------------------------------
# 4. SCANNER DE CÓDIGO DE BARRAS & OCR (Extração dos 44 dígitos)
# ------------------------------------------------------------------------------
OCR_ENABLED=true
TESSERACT_LANG=por+eng
PDF_DPI=300
# Caminhos personalizados caso não estejam no PATH global do sistema:
# TESSERACT_CMD=/usr/bin/tesseract
# POPPLER_PATH=/usr/bin

# ------------------------------------------------------------------------------
# 5. DIRETÓRIOS E LOGS
# ------------------------------------------------------------------------------
INPUT_DIR=./input_danfes
PROCESSED_DIR=./processed
FAILED_DIR=./failed
LOG_DIR=./logs
DATA_DIR=./data
LOG_LEVEL=INFO
LOG_TO_FILE=true

# ==============================================================================
# Banco Inter PJ (Banking API v2) — conciliação bancária de Contas a Pagar
# ==============================================================================
# Certificados mTLS: <empresa>.crt e <empresa>.key em INTER_CERTS_DIR (legíveis pelo container)
INTER_CERTS_DIR=./data/certs/inter
# Credenciais OAuth2 geradas no Internet Banking (Aplicações > API) de cada conta
INTER_FABRILUX_CLIENT_ID=
INTER_FABRILUX_CLIENT_SECRET=
INTER_REVESTA_CLIENT_ID=
INTER_REVESTA_CLIENT_SECRET=
INTER_NORVIA_CAMPINAS_CLIENT_ID=
INTER_NORVIA_CAMPINAS_CLIENT_SECRET=
INTER_NORVIA_CURITIBA_CLIENT_ID=
INTER_NORVIA_CURITIBA_CLIENT_SECRET=
# Rotina diária de conferência de Contas a Pagar (hora do dia 0-23 e janela em dias)
CONTAS_PAGAR_ROTINA_HOUR=7
CONTAS_PAGAR_ROTINA_DIAS=60

# ==============================================================================
# Conciliação Mercado Livre × Contas a Receber Tiny (Norvia Campinas e Revesta)
# ==============================================================================
# Hora (0-23) da rotina diária (liberações do Mercado Pago do dia anterior)
ML_RECONCILIATION_HOUR=8
# Dias antes do período para buscar vendas do ML (o dinheiro é liberado semanas depois)
ML_RECONCILIATION_VENDAS_DIAS=60
# Espera máxima pelo relatório de liberações do Mercado Pago (segundos) e análises guardadas
ML_RECONCILIATION_RELATORIO_TIMEOUT_SECONDS=900
ML_RECONCILIATION_MAX_ANALISES=180
# ml_tokens.json: o financeiro grava em DATA_DIR/ml_tokens.json (0600) e lê esse primeiro; ML_TOKENS_FILE é leitura extra opcional.
# ML_TOKENS_FILE=data/ml_tokens.json
# ML_OAUTH_RENOVACAO_PROPRIA=false
# ML_NORVIA_ACCESS_TOKEN=
# ML_REVESTA_ACCESS_TOKEN=
# Credenciais OAuth do Mercado Pago (Client ID e Client Secret por conta)
# Permite renovação automática de access token via POST /oauth/token.
MP_NORVIA_CAMPINAS_CLIENT_ID=
MP_NORVIA_CAMPINAS_CLIENT_SECRET=
MP_REVESTA_CLIENT_ID=
MP_REVESTA_CLIENT_SECRET=
# Access token de PRODUÇÃO do Mercado Pago (não expira). Sem ele ou OAuth, usa o token do ML da mesma conta.
MP_NORVIA_CAMPINAS_ACCESS_TOKEN=
MP_REVESTA_ACCESS_TOKEN=
# IDs fixos no Tiny (opcionais; sem eles a conta e a categoria são localizadas pelo nome)
# ML_REVESTA_CONTA_DESTINO_ID=
# ML_REVESTA_CATEGORIA_RECEBIMENTO_ID=

# Integração TMS (login e renovação contínua de tokens do Mercado Livre)
# TMS_BASE_URL=https://servidor.norvia.example/tms_api
# TMS_USER=seu_usuario_tms
# TMS_PASSWORD=sua_senha_tms
