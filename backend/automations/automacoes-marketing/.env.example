# ==============================================================================
# NORVIA ACABAMENTOS - AUTOMAÇÃO DE MARKETING (JORNAL DE ARQUITETURA & INSTAGRAM)
# ==============================================================================

# 1. Segurança e Execução Local
API_PORT=8004
MOCK_MODE=false
# true só em dev local/testes; no servidor fica false e a chave abaixo é a mesma do gateway
INTERNAL_AUTH_DISABLED=false
AUTOMATIONS_INTERNAL_KEY=

# 2. Camada 1: Triagem e Roteamento FinOps (100% Gratuito)
GEMINI_API_KEY=
GEMINI_FREE_MODEL=gemini-3.8-flash
# Reservas quando o principal está sobrecarregado (HTTP 500/503)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest

GROQ_API_KEY=
GROQ_FREE_MODEL=openai/gpt-oss-120b

# 3. Camada 2: Copywriting Editorial Opcional (Claude / OpenAI)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# 4. Rotina semanal (sexta, fuso de SP)
GERAR_SEXTA_AUTOMATICO=true
HORA_GERACAO_SEXTA=8

# 5. Integração RD Station Marketing (ainda não usada: o HTML é copiado e colado no RD)
RD_STATION_CLIENT_ID=
RD_STATION_CLIENT_SECRET=
RD_STATION_REFRESH_TOKEN=
