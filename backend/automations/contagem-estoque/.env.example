# ==============================================================================
# .env.example - Contagem de estoque por prendedores verdes (bot do Telegram)
# ==============================================================================
# Copie para .env nesta pasta:  cp .env.example .env
# O .env está no .gitignore — nunca commite o token real.
# ==============================================================================

# Token do bot, gerado pelo @BotFather no Telegram.
TELEGRAM_STOCK_BOT_TOKEN=

# Quem pode usar o bot: IDs numéricos do Telegram, separados por vírgula. Responde se o usuário
# OU o chat (grupo; ID negativo) estiver na lista. As duas vazias = qualquer pessoa (aviso no log).
# Para descobrir o ID: veja "mensagem ignorada ... telegram_user_id=" no log, ou o @userinfobot.
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ALLOWED_CHATS=

# true: mantém a foto recebida e a processada em temp/ para investigar a calibração.
# false: apaga as duas logo depois de responder ao operador.
STOCK_COUNTER_DEBUG=false

# Pastas de trabalho (relativas à pasta do módulo).
TEMP_DIR=./temp
LOG_DIR=./logs
LOG_TO_FILE=true
LOG_LEVEL=INFO

# Limites da foto: lado maior mínimo (abaixo disso a contagem erra), tamanho e megapixels máximos.
MIN_LADO_FOTO=960
MAX_ARQUIVO_MB=20
MAX_MEGAPIXELS=40

# Registro das contagens (SKU, quantidade, confirmação do operador, imagem anotada).
# Vazio = TEMP_DIR/registro (no servidor, temp/ já é volume persistente).
REGISTRO_DIR=
REGISTRO_RETENCAO_DIAS=60

# ------------------------------------------------------------------------------
# Detector — valores iniciais NÃO calibrados. Ajuste com fotos reais usando
# scripts/calibrate.py (ver README, seção Calibração).
# ------------------------------------------------------------------------------
# Cor do prendedor em HSV na escala do OpenCV (H 0-179, S e V 0-255).
# Verde-amarelado dos prendedores: H ≈ 43-54 numa foto de referência.
# 32 (era 35): sob luz quente o verde dos prendedores desce para H ~34 (teste de 2026-10-07).
MARKER_HUE_MIN=32
MARKER_HUE_MAX=65
MARKER_SATURATION_MIN=70
MARKER_SATURATION_MAX=255
MARKER_VALUE_MIN=40
MARKER_VALUE_MAX=255

# Largura máxima de processamento (px). Fotos maiores são reduzidas.
MAX_PROCESSING_WIDTH=1600

# Morfologia: OPEN remove ruído (MORPH_KERNEL_SIZE), CLOSE fecha falhas (MORPH_CLOSE_KERNEL_SIZE).
MORPH_KERNEL_SIZE=5
MORPH_CLOSE_KERNEL_SIZE=9

# Área do marcador em px, medida numa imagem de largura MAX_PROCESSING_WIDTH.
MIN_MARKER_AREA=150
MAX_MARKER_AREA=40000
# Prendedor atrás do plástico aparece só em parte. Com a área típica da foto conhecida, o
# mínimo é o MENOR entre MIN_MARKER_AREA e MIN_MARKER_AREA_RATIO x área típica, mas nunca
# abaixo de MARKER_NOISE_AREA.
MIN_MARKER_AREA_RATIO=0.2
MARKER_NOISE_AREA=40

# Proporção lado maior / lado menor (1 = quadrado/redondo). O prendedor é alongado (~4-6).
MIN_ASPECT_RATIO=1.0
MAX_ASPECT_RATIO=7.0

# Pedaços verdes a até esta distância entre as bordas contam como um só marcador.
# Vale o maior entre MERGE_DISTANCE (px fixos) e MERGE_DISTANCE_RATIO x tamanho
# típico dos marcadores da foto (acompanha fotos de perto e de longe).
MERGE_DISTANCE=10
MERGE_DISTANCE_RATIO=0.25

# Região com pelo menos esta fração da área típica é um prendedor INTEIRO: dois inteiros
# nunca são unidos, e os que o MORPH_CLOSE juntou (prendedores encostados) são separados.
WHOLE_MARKER_AREA_RATIO=0.6

# Marcador abaixo desta fração da área típica sai em amarelo para o operador conferir.
ALERTA_AREA_RATIO=0.5

# Marcadores com diferença vertical < esta fração da altura de um marcador ficam na mesma linha.
ROW_TOLERANCE_RATIO=0.8

# ─── Integração com o estoque do Tiny (conferência no painel) ───────────────────────────
# API interna deste serviço (gateway → contagem-estoque). Mesma chave das outras automações.
API_PORT=8002
AUTOMATIONS_INTERNAL_KEY=
# Tokens do Tiny: tabela api_tokens do banco do financeiro (só leitura).
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
TINY_TOKENS_DB=financeiro
# A conta do Tiny é fixa no código: SÓ Revesta (não há variável para trocar).
# Depósito da entrada (vazio = único depósito do produto).
CONTAGEM_TINY_DEPOSITO_ID=
