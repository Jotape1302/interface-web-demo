# Copie para .env (na mesma pasta do iniciar.bat) e ajuste se precisar.
PORT=8003
# 0.0.0.0 (padrão): o tablet pode chamar direto pela rede local. Se só usar o Cloudflare Tunnel,
# troque para 127.0.0.1 (a porta deixa de ser alcançável pela rede).
HOST=0.0.0.0

# Nome exato da impressora no Windows (Configurações → Impressoras). Vazio: procura Elgin/L42/Zebra.
IMPRESSORA=

# Linguagem da impressora: epl (padrão) ou zpl. A Elgin L42-DT vem em PPLB/EPL: recebe ZPL mas
# solta as etiquetas em branco. Se um dia trocar por Zebra ou ativar o PPLZ na Elgin, use LINGUAGEM=zpl.
LINGUAGEM=epl
# Só EPL: escuridão da impressão (0 a 15) e espaço entre etiquetas em pontos (24 = 3 mm a 203 dpi).
DENSIDADE=10
GAP_DOTS=24

# Elgin L42-DT: 203 dpi, etiqueta 60 x 40 mm
DPI=203
LARGURA_MM=60
ALTURA_MM=40

# true se os acentos saírem como símbolos estranhos na etiqueta
REMOVER_ACENTOS=false

# Obrigatória: o sistema de OP manda o header X-Api-Key com este valor (mínimo 32 caracteres).
# Sem ela o servidor não inicia. Gere uma aleatória, ex. no PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
CHAVE_API=

# true: só mostra o ZPL no terminal, não imprime (teste sem gastar etiqueta)
SIMULACAO=false

# Limites por cliente (IP), por minuto. Cada pedido continua aceitando de 1 a 1000 cópias;
# LIMITE_COPIAS_MINUTO precisa ser >= 1000. 0 desliga o limite.
LIMITE_REQUISICOES_MINUTO=30
LIMITE_COPIAS_MINUTO=2000

# Origens do navegador liberadas no CORS, separadas por vírgula (ex.: https://op.norvia.example).
# Vazio = qualquer origem ("*"); aceitável porque toda chamada exige a CHAVE_API.
CORS_ORIGINS=
